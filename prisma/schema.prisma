model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique // Flutterwave's explicit event ID or compound hash
  provider    String // e.g., "FLUTTERWAVE"
  eventType   String // e.g., "charge.completed"
  processed   Boolean  @default(false)
  processedAt DateTime @default(now())

  @@index([eventId])
}

model PaymentAuditLog {
  id        String          @id @default(uuid())
  paymentId String
  event     PaymentLogEvent
  payload   Json
  createdAt DateTime        @default(now())
  payment   Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([event])
}

enum PaymentLogEvent {
  PAYMENT_INITIALIZED
  WEBHOOK_RECEIVED
  VERIFICATION_STARTED
  VERIFICATION_SUCCESS
  VERIFICATION_FAILED
  SETTLEMENT_QUEUED
  SETTLEMENT_PROCESSING
  SETTLEMENT_COMPLETED
  SETTLEMENT_FAILED
}

model FinancialLedger {
  id            String     @id @default(uuid())
  reference     String     @unique // Compound tracking reference (e.g., TX-REF or JobID)
  walletId      String // Maps to VendorWallet ID, MarketingWallet ID, or Platform account
  walletType    WalletType
  type          LedgerType
  amount        Decimal    @db.Decimal(12, 2)
  balanceBefore Decimal    @db.Decimal(12, 2)
  balanceAfter  Decimal    @db.Decimal(12, 2)
  description   String
  metadata      Json?
  createdAt     DateTime   @default(now())

  @@index([walletId, walletType])
  @@index([createdAt])
}

enum WalletType {
  VENDOR
  MARKETER
  PLATFORM_RESERVE
}

enum LedgerType {
  DEBIT // Money moving OUT of the wallet
  CREDIT // Money moving INTO the wallet
}

model ReconciliationException {
  id               String               @id @default(uuid())
  paymentReference String               @unique
  reason           String
  severity         FraudSeverity        @default(HIGH)
  status           ReconciliationStatus @default(UNRESOLVED)
  details          Json?
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([status])
}

enum ReconciliationStatus {
  UNRESOLVED
  INVESTIGATING
  RESOLVED_MANUALLY
  IGNORED
}

model DeadLetterJob {
  id         String   @id @default(uuid())
  queueName  String
  jobName    String
  jobId      String   @unique
  payload    Json
  reason     String
  stackTrace String?
  isResolved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isResolved])
}

