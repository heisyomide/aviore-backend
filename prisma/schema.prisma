generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  password               String
  firstName              String?
  middleName             String?
  dob                    DateTime? // Added database column (or String if you prefer unparsed text)
  lastName               String?
  phone                  String?
  isActive               Boolean              @default(true)
  role                   Role                 @default(CUSTOMER)
  createdAt              DateTime             @default(now())
  pushToken              String?
  is2faEnabled           Boolean              @default(false)
  referralCode           String               @unique
  referredById           String?
  hasUnlockedVoucher     Boolean              @default(false)
  hasUsedReferralVoucher Boolean              @default(false)
  signupIp               String?
  pushSubscriptions      PushSubscription[]
  deviceFingerprint      String?
  isEmailVerified        Boolean              @default(false)
  addresses              Address[]
  auditLogs              AuditLog[]
  blockedIps             BlockedIp[]          @relation("AdminBlockedIps")
  browsingHistory        BrowsingHistory[]
  cart                   Cart?
  notificationSettings   NotificationSetting?
  notifications          Notification[]
  orders                 Order[]
  conversations          OrderConversation[]
  receivedReferrals      ReferralLog[]        @relation("ReferredUserRelation")
  sentReferrals          ReferralLog[]        @relation("ReferrerRelation")
  refreshTokens          RefreshToken[]
  returnRequests         ReturnRequest[]
  reviews                Review[]
  sessions               Session[]
  tickets                Ticket[]
  referredBy             User?                @relation("UserReferrals", fields: [referredById], references: [id])
  invitees               User[]               @relation("UserReferrals")
  vendor                 Vendor?
  followers              VendorFollower[]
  vouchers               Voucher[]
  wishlist               Wishlist[]

  @@index([email])
}

model ReferralLog {
  id                String   @id @default(uuid())
  referrerId        String
  referredUserId    String
  referralCodeUsed  String
  ipAddress         String?
  deviceFingerprint String?
  isQualified       Boolean  @default(false)
  isFraudulent      Boolean  @default(false)
  createdAt         DateTime @default(now())
  referredUser      User     @relation("ReferredUserRelation", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrer          User     @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referredUserId])
}

model Voucher {
  id             String        @id @default(uuid())
  code           String        @unique
  discountAmount Float         @default(2500)
  minimumOrder   Float         @default(15000)
  status         VoucherStatus @default(ACTIVE)
  expiresAt      DateTime
  usedAt         DateTime?
  userId         String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String // Links to your User model
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model VendorFollower {
  id        String   @id @default(uuid())
  vendorId  String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  vendor    Vendor   @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, userId])
}

model Session {
  id                String   @id @default(uuid())
  userId            String
  refreshToken      String
  device            String
  ipAddress         String
  lastUsed          DateTime @default(now())
  isCurrent         Boolean  @default(false)
  deviceFingerprint String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlockedIp {
  id        String   @id @default(cuid())
  ip        String   @unique
  reason    String?
  adminId   String
  createdAt DateTime @default(now())
  admin     User     @relation("AdminBlockedIps", fields: [adminId], references: [id])
}

model LoginLog {
  id                String   @id @default(cuid())
  email             String
  ip                String
  userAgent         String?
  status            String
  createdAt         DateTime @default(now())
  deviceFingerprint String?
}

model NotificationSetting {
  id            String  @id @default(uuid())
  userId        String  @unique
  orderUpdates  Boolean @default(true)
  promotions    Boolean @default(false)
  chatMessages  Boolean @default(true)
  storeActivity Boolean @default(false)
  priceDrops    Boolean @default(true)
  emailEnabled  Boolean @default(true)
  smsEnabled    Boolean @default(false)
  pushEnabled   Boolean @default(true)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  tag         String
  imageUrl    String
  discount    String?
  bgColor     String?
  accentColor String?
  isActive    Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Address {
  id          String   @id @default(uuid())
  fullName    String
  phoneNumber String
  street      String
  city        String
  state       String
  postalCode  String?
  isDefault   Boolean  @default(false)
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  orders      Order[]
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model BrowsingHistory {
  id        String   @id @default(uuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Vendor {
  id                   String                @id @default(uuid())
  storeName            String
  imageUrl             String?
  isVerified           Boolean               @default(false)
  userId               String                @unique
  bankName             String?
  accountNumber        String?
  slug                 String?               @unique
  description          String?
  shippingFee          Float                 @default(0.0)
  commission           Float                 @default(10.0)
  walletBalance        Decimal               @default(0.0)
  status               VendorStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now())
  kycStatus            KycStatus             @default(NOT_SUBMITTED)
  idType               String?
  idNumber             String?
  idImage              String?
  accountName          String?
  bankCode             String?
  growthStatus         GrowthVendorStatus    @default(PENDING)
  marketerId           String?
  verifiedProducts     Int                   @default(0)
  campaignParticipants CampaignParticipant[]
  campaignProducts     CampaignProduct[]
  coupons              Coupon[]
  growthCommissionLogs GrowthCommissionLog[]
  orders               Order[]
  products             Product[]
  reviews              Review[]
  marketer             Marketer?             @relation("MarketerToVendor", fields: [marketerId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  followers            VendorFollower[]
  vendorWallet         VendorWallet?
  transactions         WalletTransaction[]
  withdrawalRequests   WithdrawalRequest[]

  @@index([marketerId])
  @@index([growthStatus])
}

model ProductCoupon {
  id        String   @id @default(cuid())
  productId String
  couponId  String
  vendorId  String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, couponId])
  @@index([couponId])
  @@index([vendorId])
}

model Coupon {
  id                String          @id @default(cuid())
  code              String          @unique
  description       String?
  type              CouponType      @default(VENDOR)
  discountType      DiscountType    @default(PERCENTAGE)
  discountValue     Decimal         @db.Decimal(10, 2)
  maxDiscountAmount Decimal?        @db.Decimal(10, 2)
  minOrderValue     Decimal?        @db.Decimal(10, 2)
  usageLimit        Int             @default(100)
  usedCount         Int             @default(0)
  perUserLimit      Int             @default(1)
  vendorId          String?
  startDate         DateTime        @default(now())
  endDate           DateTime
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  vendor            Vendor?         @relation(fields: [vendorId], references: [id])
  Order             Order[]
  productCoupons    ProductCoupon[]
  usages            CouponUsage[]

  @@index([code])
  @@index([vendorId])
  @@index([isActive, startDate, endDate])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  content     String
  targetGroup AnnouncementTarget
  adminId     String
  priority    AnnouncementPriority @default(NORMAL)
  expiresAt   DateTime?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
}

model WalletTransaction {
  id                  String             @id @default(uuid())
  vendorId            String
  amount              Decimal
  metadata            Json?
  type                TransactionType
  status              String             @default("COMPLETED")
  reference           String             @unique
  description         String?
  createdAt           DateTime           @default(now())
  withdrawalRequestId String?
  vendor              Vendor             @relation(fields: [vendorId], references: [id])
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])
}

model Product {
  id               String            @id @default(uuid())
  title            String
  description      String
  price            Decimal           @db.Decimal(12, 2)
  stock            Int               @default(0)
  sku              String?           @unique
  status           ProductStatus     @default(PENDING)
  isActive         Boolean           @default(true)
  isDeleted        Boolean           @default(false)
  vendorId         String
  origin           String            @default("LOCAL")
  deliveryMin      Int               @default(1)
  deliveryMax      Int               @default(3)
  storeId          String?
  categoryId       String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  averageRating    Float             @default(0)
  reviewCount      Int               @default(0)
  oldPrice         Float?
  browsingHistory  BrowsingHistory[]
  campaignProducts CampaignProduct[]
  cartItems        CartItem[]
  orderItems       OrderItem[]
  category         Category          @relation(fields: [categoryId], references: [id])
  vendor           Vendor            @relation(fields: [vendorId], references: [id])
  productCoupons   ProductCoupon[]
  images           ProductImage[]
  variants         ProductVariant[]
  reviews          Review[]
  wishlist         Wishlist[]

  @@index([vendorId])
  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(uuid())
  imageUrl  String
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model ProductVariant {
  id         String         @id @default(uuid())
  productId  String
  color      String?
  size       String?
  material   String?
  price      Decimal?       @db.Decimal(12, 2)
  stock      Int            @default(0)
  sku        String?        @unique
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     VariantImage[]

  @@unique([productId, color, size, material])
}

model VariantImage {
  id               String         @id @default(uuid())
  imageUrl         String
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
}

model Order {
  id                   String                @id @default(uuid())
  orderNumber          String?               @unique @default(cuid())
  totalAmount          Decimal               @db.Decimal(12, 2)
  totalPaid            Decimal?              @db.Decimal(12, 2)
  commission           Decimal?              @db.Decimal(12, 2)
  vendorEarning        Decimal?              @db.Decimal(12, 2)
  status               OrderStatus           @default(PENDING)
  payoutStatus         PayoutStatus          @default(LOCKED)
  trackingNumber       String?
  carrier              String?
  vendorId             String?
  userId               String
  addressId            String?
  couponId             String?
  createdAt            DateTime              @default(now())
  dispute              Dispute?
  growthCommissionLogs GrowthCommissionLog[]
  address              Address?              @relation(fields: [addressId], references: [id])
  Coupon               Coupon?               @relation(fields: [couponId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])
  vendor               Vendor?               @relation(fields: [vendorId], references: [id])
  campaignLogs         OrderCampaign[]
  orderConversation    OrderConversation?
  items                OrderItem[]
  payment              Payment?
  returnRequest        ReturnRequest?
}

model OrderCampaign {
  id             String   @id @default(uuid())
  orderId        String
  title          String
  discountAmount Float
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  productId String
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  variantId String?
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  reply     String?
  productId String
  userId    String
  vendorId  String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  vendor    Vendor   @relation(fields: [vendorId], references: [id])

  @@unique([productId, userId])
}

model OrderItem {
  id                    String          @id @default(uuid())
  quantity              Int
  priceAtPurchase       Decimal         @db.Decimal(12, 2)
  orderId               String
  productId             String
  status                String          @default("PENDING") // PENDING, PROCESSING, SHIPPED, DELIVERED
  commission            Float?
  vendorEarning         Float?
  payoutStatus          String?         @default("LOCKED")
  createdAt             DateTime        @default(now())
  variantId             String?
  retailAmount          Decimal?        @db.Decimal(12, 2)
  vendorCouponDiscount  Decimal?        @db.Decimal(12, 2)
  referralDiscount      Decimal?        @db.Decimal(12, 2)
  customerPaid          Decimal?        @db.Decimal(12, 2)
  platformCommission    Decimal?        @db.Decimal(12, 2)
  vendorId              String?
  couponId              String?
  platformNetCommission Decimal?        @db.Decimal(12, 2)
  marketingCommission   Decimal?        @db.Decimal(12, 2)
  order                 Order           @relation(fields: [orderId], references: [id])
  product               Product         @relation(fields: [productId], references: [id])
  variant               ProductVariant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id String @id @default(uuid())

  reference String @unique

  amount Decimal @db.Decimal(12, 2)

  status PaymentStatus @default(PENDING)

  provider String

  orderId String @unique

  metadata String?

  externalId String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  auditLogs PaymentAuditLog[]
}

model WithdrawalRequest {
  id                 String              @id @default(uuid())
  amount             Decimal             @db.Decimal(12, 2)
  status             WithdrawalStatus    @default(PENDING)
  vendorId           String
  bankDetails        Json
  createdAt          DateTime            @default(now())
  metadata           Json?
  updatedAt          DateTime            @updatedAt
  walletTransactions WalletTransaction[]
  vendor             Vendor              @relation(fields: [vendorId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  parentId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryToSub", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToSub")
  products  Product[]

  @@index([parentId])
}

model OrderConversation {
  id        String         @id @default(cuid())
  orderId   String         @unique
  userId    String
  vendorId  String
  isFrozen  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  order     Order          @relation(fields: [orderId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  messages  OrderMessage[]
}

model OrderMessage {
  id             String            @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     String
  content        String
  type           String            @default("TEXT")
  isFlagged      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  conversation   OrderConversation @relation(fields: [conversationId], references: [id])
}

model ReturnRequest {
  id            String   @id @default(cuid())
  orderId       String   @unique
  userId        String
  vendorId      String
  reason        String
  description   String
  imageProof    String?
  status        String   @default("REQUESTED")
  adminDecision String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  order         Order    @relation(fields: [orderId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
}

model VendorWallet {
  id               String   @id @default(cuid())
  vendorId         String   @unique
  pendingBalance   Decimal  @default(0.00) @db.Decimal(12, 2)
  availableBalance Decimal  @default(0.00) @db.Decimal(12, 2)
  totalEarnings    Decimal  @default(0.00) @db.Decimal(12, 2)
  bankName         String?
  accountNumber    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  vendor           Vendor   @relation(fields: [vendorId], references: [id])
}

model Ticket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt
  user      User         @relation(fields: [userId], references: [id])
}

model FAQ {
  id       String @id @default(cuid())
  question String
  answer   String
  category String
}

model AuditLog {
  id         String      @id @default(cuid())
  adminId    String
  action     AuditAction
  targetId   String?
  targetType String?
  details    String?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  admin      User        @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetId])
  @@index([createdAt])
}

model Campaign {
  id           String                @id @default(cuid())
  title        String
  description  String
  discount     Float
  bannerUrl    String?
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  participants CampaignParticipant[]
  products     CampaignProduct[]
}

model CampaignParticipant {
  id         String   @id @default(cuid())
  campaignId String
  vendorId   String
  joinedAt   DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  vendor     Vendor   @relation(fields: [vendorId], references: [id])

  @@unique([campaignId, vendorId])
}

model CampaignProduct {
  id         String   @id @default(cuid())
  campaignId String
  productId  String
  vendorId   String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  vendor     Vendor   @relation(fields: [vendorId], references: [id])

  @@unique([campaignId, productId])
}

model FraudLog {
  id          String        @id @default(cuid())
  userId      String?
  vendorId    String?
  orderId     String?
  severity    FraudSeverity
  type        FraudType
  description String
  isResolved  Boolean       @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([vendorId])
}

model Dispute {
  id           String            @id @default(cuid())
  orderId      String            @unique
  customerId   String
  vendorId     String
  reason       String
  status       DisputeStatus     @default(OPEN)
  refundAmount Decimal?          @db.Decimal(10, 2)
  resolution   String?
  adminId      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  order        Order             @relation(fields: [orderId], references: [id])
  evidences    DisputeEvidence[]
  messages     DisputeMessage[]
}

model DisputeEvidence {
  id         String   @id @default(cuid())
  disputeId  String
  url        String
  uploadedBy String
  createdAt  DateTime @default(now())
  dispute    Dispute  @relation(fields: [disputeId], references: [id])
}

model DisputeMessage {
  id        String   @id @default(cuid())
  disputeId String
  senderId  String
  message   String
  createdAt DateTime @default(now())
  dispute   Dispute  @relation(fields: [disputeId], references: [id])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Marketer {
  id              String                @id @default(uuid())
  name            String
  teamCode        String
  passcodeHash    String
  role            MarketerRole          @default(SUB_MARKETER)
  status          MarketerStatus        @default(ACTIVE)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  accountName     String?
  accountNumber   String?               @db.VarChar(10)
  bankName        String?               @default("Access Bank Plc")
  trackingTag     String?               @unique
  totalEarnings   Decimal?              @default(0.00) @db.Decimal(12, 2)
  currentBalance  Decimal?              @default(0.00) @db.Decimal(12, 2)
  withdrawnAmount Decimal?              @default(0.00) @db.Decimal(12, 2)
  referralCode    String?
  commissionLogs  GrowthCommissionLog[]
  payouts         GrowthPayoutRequest[]
  settings        MarketerSettings?
  wallet          MarketingWallet?
  vendors         Vendor[]              @relation("MarketerToVendor")

  @@unique([teamCode, passcodeHash])
  @@index([teamCode])
}

model MarketerSettings {
  id                    String   @id @default(uuid())
  marketerId            String   @unique
  onVendorSignup        Boolean  @default(true)
  onSaleDelivered       Boolean  @default(true)
  onPayoutSettled       Boolean  @default(true)
  weeklyDigest          Boolean  @default(false)
  globalAllocationSplit Int      @default(20)
  voucherSignLimit      Int      @default(5)
  updatedAt             DateTime @updatedAt
  marketer              Marketer @relation(fields: [marketerId], references: [id], onDelete: Cascade)
}

model MarketingWallet {
  id            String   @id @default(uuid())
  marketerId    String   @unique
  balance       Decimal  @default(0.00) @db.Decimal(12, 2)
  bankName      String?
  accountNumber String?
  accountName   String?
  updatedAt     DateTime @updatedAt
  marketer      Marketer @relation(fields: [marketerId], references: [id], onDelete: Cascade)
}

model GrowthCommissionLog {
  id                       String   @id @default(uuid())
  orderId                  String
  marketerId               String
  vendorId                 String
  grossOrderAmount         Float
  platformFeeRetained      Float
  marketingSplitPaid       Float
  vendorPayoutAmount       Float
  createdAt                DateTime @default(now())
  orderItemId              String?  @unique
  retailAmount             Decimal? @default(0) @db.Decimal(12, 2)
  vendorCouponDiscount     Decimal? @default(0) @db.Decimal(12, 2)
  referralDiscount         Decimal? @default(0) @db.Decimal(12, 2)
  customerPaid             Decimal? @default(0) @db.Decimal(12, 2)
  vendorPayout             Decimal? @default(0) @db.Decimal(12, 2)
  platformGrossCommission  Decimal? @default(0) @db.Decimal(12, 2)
  platformNetCommission    Decimal? @default(0) @db.Decimal(12, 2)
  marketerCommission       Decimal? @default(0) @db.Decimal(12, 2)
  avioreCommission         Decimal? @default(0) @db.Decimal(12, 2)
  commissionType           String?  @default("ORGANIC")
  paymentGatewayReference  String?
  flutterwaveTransactionId String?

  marketer Marketer @relation(fields: [marketerId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])
  vendor   Vendor   @relation(fields: [vendorId], references: [id])

  // Cleaned up duplicate indices to optimize database lookups
  @@index([marketerId], map: "idx_growth_marketer")
  @@index([orderId], map: "idx_growth_order")
  @@index([orderItemId], map: "idx_growth_order_item")
  @@index([vendorId], map: "idx_growth_vendor")
}

model GrowthPayoutRequest {
  id              String             @id @default(uuid())
  marketerId      String
  amount          Float
  status          GrowthPayoutStatus @default(PENDING)
  referenceString String             @unique
  bankName        String
  accountNumber   String
  accountName     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  marketer        Marketer           @relation(fields: [marketerId], references: [id])

  @@index([marketerId])
}

